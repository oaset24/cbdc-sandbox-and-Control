# Port 5433 = Docker-Compose (postgres mapped auf Host 5433), siehe Root docker-compose.yml
# P1000 / 28P01: (1) Falscher Port → lokaler PostgreSQL statt Container
#                 (2) Volume mit altem Passwort → docker compose down -v && docker compose up -d
DATABASE_URL=postgresql://cbdc_user:cbdc_secure_pass@127.0.0.1:5433/cbdc_db?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=cbdc_super_secret_key_2024
PORT=3001
# Kommagetrennte Origins für CORS; leer lassen = alle Origins (nur für lokale Dev)
CORS_ORIGINS=http://localhost:3000

# Optional: Blockchain
BLOCKCHAIN_RPC_URL=
CBDC_CONTRACT_ADDRESS=
BLOCKCHAIN_ADMIN_PRIVATE_KEY=
BLOCKCHAIN_USER_WALLET_PRIVATE_KEY=
